#!/bin/bash
# Stand-in for Steam. Its window belongs to a helper started by relative path,
# as the real client's belongs to ./steamwebhelper, so restore cannot replay
# the command line and has to find the client through a .desktop entry. Given a
# game's URL, which is how every shortcut Steam writes starts it, it opens that
# game's window too.
for arg in "$@"; do
    case $arg in
        steam://rungameid/*)
            foot --app-id="steam_app_${arg##*/}" --title="game ${arg##*/}" sleep 86400 &
            ;;
    esac
done
exec -a ./steamwebhelper foot --app-id=steam --title=Steam sleep 86400
